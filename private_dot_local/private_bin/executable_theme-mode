#!/usr/bin/env bash
#
# theme-mode -- switch every themed surface between the two modus pairs at
# once: Emacs, Neovim, fish, Ghostty, tmux, starship, btop and the desktop.
#
#   theme-mode           print the current mode
#   theme-mode dark      modus-vivendi-tinted
#   theme-mode light     modus-operandi
#   theme-mode toggle    flip
#   theme-mode --check   report what each surface actually thinks the mode is
#
# The mode lives in $XDG_STATE_HOME/theme-mode and every tool reads it at
# startup, so a new shell, editor or tmux server always comes up correct.
# The rest of this script exists for the sessions ALREADY running: none of
# them poll, so each has to be pushed at, and each has its own way in.
#
# Ghostty needs nothing here. Its config names both themes at once
# (theme = light:...,dark:...) and follows the desktop colour-scheme, which
# this script sets (GNOME via gsettings, macOS via System Events) -- so it is
# driven, just not by a push.

set -u

STATE_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/theme-mode"
STARSHIP_LIGHT="${XDG_CACHE_HOME:-$HOME/.cache}/starship/light.toml"

current_mode() {
    case "$([ -r "$STATE_FILE" ] && cat "$STATE_FILE")" in
        light) echo light ;;
        *)     echo dark ;;
    esac
}

# GNOME, and through it Ghostty and the GTK apps.
#
# The icon and GTK themes belong to the mode, not to the desktop look: pinning
# them dark leaves light mode with dark icons on a light panel. desktop-theme(1)
# therefore sets none of these three keys -- this is their only owner.
# The wallpaper needs no case of its own: desktop-wallpaper(1) writes both
# picture-uri and picture-uri-dark, and GNOME picks by colour-scheme.
push_desktop() {
    # macOS: the appearance is the only desktop knob, and Ghostty's
    # window-theme = auto follows it. The first run may raise a one-time
    # Automation permission prompt for System Events.
    if [ "$(uname -s)" = Darwin ]; then
        command -v osascript >/dev/null 2>&1 || return 0
        local dark=true
        [ "$1" = light ] && dark=false
        osascript -e "tell application \"System Events\" to tell appearance preferences to set dark mode to $dark" >/dev/null 2>&1 || true
        return 0
    fi
    command -v gsettings >/dev/null 2>&1 || return 0
    local scheme icons gtk
    case "$1" in
        light) scheme=prefer-light; icons=Colloid-Light; gtk=Yaru ;;
        *)     scheme=prefer-dark;  icons=Colloid-Dark;  gtk=Yaru-dark ;;
    esac
    {
        gsettings set org.gnome.desktop.interface color-scheme "$scheme"
        gsettings set org.gnome.desktop.interface gtk-theme "$gtk"
        # Only when that variant is actually installed: setup.sh installs
        # Colloid on Linux, and a machine without it keeps its own icons
        # rather than being pointed at a theme that is not there.
        if [ -d "$HOME/.local/share/icons/$icons" ] || [ -d "/usr/share/icons/$icons" ]; then
            gsettings set org.gnome.desktop.interface icon-theme "$icons"
        fi
    } 2>/dev/null || true
}

# A universal variable reaches every running fish at once, where the
# --on-variable handler in conf.d/modus-theme.fish repaints the palette.
push_fish() {
    command -v fish >/dev/null 2>&1 || return 0
    fish -c "set -U __theme_mode $1" >/dev/null 2>&1 || true
}

push_tmux() {
    command -v tmux >/dev/null 2>&1 || return 0
    tmux has-session >/dev/null 2>&1 || return 0
    tmux source-file "$HOME/.tmux.conf" >/dev/null 2>&1 || true
}

# Neovim listens on a socket per instance without being asked, so every
# running editor can be reached by name.
push_nvim() {
    command -v nvim >/dev/null 2>&1 || return 0
    local sock
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
        [ -S "$sock" ] || continue
        nvim --server "$sock" --remote-expr \
            "luaeval(\"require('naamanu.theme').apply(_A)\", '$1')" >/dev/null 2>&1 || true
    done
}

# Only when a server is actually up: emacsclient without one blocks or errors.
push_emacs() {
    command -v emacsclient >/dev/null 2>&1 || return 0
    local sock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/emacs/server"
    [ -S "$sock" ] || return 0
    emacsclient --eval "(my/apply-theme-mode \"$1\")" >/dev/null 2>&1 || true
}

# starship cannot pick a palette from the environment, so the light variant is
# the managed config with a single line rewritten. Regenerated on every switch,
# so an edit to starship.toml can never leave it stale.
regen_starship_light() {
    local src="$HOME/.config/starship.toml"
    [ -r "$src" ] || return 0
    mkdir -p "$(dirname "$STARSHIP_LIGHT")"
    sed 's/^palette = .*/palette = "modus_light"/' "$src" > "$STARSHIP_LIGHT"
}

# btop has no light/dark notion of its own, only a named theme. Both are
# generated from the ghostty theme files -- the same palettes Ghostty reads --
# so the monitor cannot drift from the terminal it runs inside.
#
# The theme name is read back out of the ghostty config rather than repeated
# here, so the pair is named in exactly one place.
ghostty_theme_for() {
    local cfg="$HOME/.config/ghostty/config" line
    [ -r "$cfg" ] || return 1
    line="$(grep -m1 '^theme *=' "$cfg")" || return 1
    line="${line#*=}"
    case "$1" in
        light) line="${line##*light:}" ;;
        *)     line="${line##*dark:}" ;;
    esac
    line="${line%%,*}"
    line="${line#"${line%%[![:space:]]*}"}"
    printf '%s' "${line%"${line##*[![:space:]]}"}"
}

# Fills P[0..15] plus P_BG, P_FG and P_SEL from a ghostty theme file. Plain
# indexed array and scalars rather than an associative array: macOS ships
# bash 3.2, which has none, and this script runs under /usr/bin/env bash.
read_ghostty_palette() {
    local name="$1" file="" dir key value line
    for dir in "$HOME/.config/ghostty/themes" /usr/share/ghostty/themes \
               /Applications/Ghostty.app/Contents/Resources/ghostty/themes; do
        [ -f "$dir/$name" ] && { file="$dir/$name"; break; }
    done
    [ -n "$file" ] || return 1
    P=(); P_BG=""; P_FG=""; P_SEL=""
    while IFS= read -r line; do
        case "$line" in
            palette*=*)
                value="${line#*=}"; value="${value# }"
                key="${value%%=*}"; P[$key]="${value#*=}" ;;
            background*=*)           P_BG="${line#*=}";  P_BG="${P_BG// /}" ;;
            foreground*=*)           P_FG="${line#*=}";  P_FG="${P_FG// /}" ;;
            selection-background*=*) P_SEL="${line#*=}"; P_SEL="${P_SEL// /}" ;;
        esac
    done < "$file"
    [ -n "$P_BG" ] || return 1
    [ -n "$P_SEL" ] || P_SEL="${P[8]}"
    return 0
}

regen_btop() {
    command -v btop >/dev/null 2>&1 || return 0
    local mode name
    for mode in dark light; do
        name="$(ghostty_theme_for "$mode")" || continue
        read_ghostty_palette "$name" || continue
        mkdir -p "$HOME/.config/btop/themes"
        cat > "$HOME/.config/btop/themes/modus-$mode.theme" <<EOF
# Generated by theme-mode(1) from the ghostty theme "$name". Do not edit.
theme[main_bg]="$P_BG"
theme[main_fg]="$P_FG"
theme[title]="$P_FG"
theme[hi_fg]="${P[12]}"
theme[selected_bg]="$P_SEL"
theme[selected_fg]="$P_FG"
theme[inactive_fg]="${P[8]}"
theme[graph_text]="${P[7]}"
theme[meter_bg]="${P[8]}"
theme[proc_misc]="${P[13]}"
theme[cpu_box]="${P[4]}"
theme[mem_box]="${P[2]}"
theme[net_box]="${P[5]}"
theme[proc_box]="${P[6]}"
theme[div_line]="${P[8]}"
theme[temp_start]="${P[4]}"
theme[temp_mid]="${P[3]}"
theme[temp_end]="${P[1]}"
theme[cpu_start]="${P[2]}"
theme[cpu_mid]="${P[3]}"
theme[cpu_end]="${P[1]}"
theme[free_start]="${P[6]}"
theme[free_mid]="${P[4]}"
theme[free_end]="${P[12]}"
theme[cached_start]="${P[14]}"
theme[cached_mid]="${P[6]}"
theme[cached_end]="${P[4]}"
theme[available_start]="${P[11]}"
theme[available_mid]="${P[3]}"
theme[available_end]="${P[9]}"
theme[used_start]="${P[10]}"
theme[used_mid]="${P[3]}"
theme[used_end]="${P[1]}"
theme[download_start]="${P[5]}"
theme[download_mid]="${P[13]}"
theme[download_end]="${P[9]}"
theme[upload_start]="${P[2]}"
theme[upload_mid]="${P[6]}"
theme[upload_end]="${P[4]}"
theme[process_start]="${P[4]}"
theme[process_mid]="${P[13]}"
theme[process_end]="${P[5]}"
EOF
    done
}

# btop reads its theme once at startup and never re-reads the config, so this
# lands on the next run rather than in a session already open.
push_btop() {
    command -v btop >/dev/null 2>&1 || return 0
    local conf="$HOME/.config/btop/btop.conf"
    mkdir -p "$(dirname "$conf")"
    # btop writes this file itself on first exit, so on a machine where it has
    # never run there is nothing to edit -- and a config naming only the theme
    # is valid: btop fills in every key it does not find.
    if [ -f "$conf" ] && grep -q '^color_theme' "$conf"; then
        sed -i "s|^color_theme.*|color_theme = \"modus-$1\"|" "$conf" 2>/dev/null || true
    else
        printf 'color_theme = "modus-%s"\n' "$1" >> "$conf"
    fi
}

# --- reporting -------------------------------------------------------------
#
# Six push paths means six ways to fail quietly: a stale universal variable, a
# dead Neovim socket, an Emacs that had no server running when the mode last
# changed. This asks each surface what it currently believes rather than
# assuming the last switch took.

MISMATCH=0
STATUS=""

row() { printf '  %-9s %-24s %s\n' "$1" "$2" "$3"; }

status_for() {  # expected actual -- deliberately not in a subshell, so
    if [ "$1" = "$2" ]; then   # MISMATCH survives
        STATUS=ok
    else
        STATUS=MISMATCH
        MISMATCH=1
    fi
}

check() {
    local mode; mode="$(current_mode)"
    echo "shared mode: $mode   ($STATE_FILE)"
    echo

    # Desktop, and through it Ghostty.
    if [ "$(uname -s)" = Darwin ]; then
        local g
        if [ "$(defaults read -g AppleInterfaceStyle 2>/dev/null)" = Dark ]; then g=dark; else g=light; fi
        status_for "$mode" "$g"; row desktop "$g" "$STATUS"
    elif command -v gsettings >/dev/null 2>&1; then
        local cs; cs="$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null | tr -d \"\'\")"
        local g; case "$cs" in prefer-light) g=light ;; prefer-dark) g=dark ;; *) g="${cs:-unset}" ;; esac
        status_for "$mode" "$g"; row desktop "$g" "$STATUS"
    else
        row desktop "no gsettings" "-"
    fi

    # Ghostty is static: it either names both themes or it does not.
    if grep -q '^theme = light:.*,dark:' "$HOME/.config/ghostty/config" 2>/dev/null; then
        row ghostty "follows desktop" "ok"
    else
        row ghostty "not following desktop" "MISMATCH"; MISMATCH=1
    fi

    if command -v fish >/dev/null 2>&1; then
        local f; f="$(fish -c 'echo $__theme_mode' 2>/dev/null)"
        status_for "$mode" "${f:-unset}"; row fish "${f:-unset}" "$STATUS"
    else
        row fish "not installed" "-"
    fi

    # Compare the live status bar against the palette file for this mode, so
    # the expected colour is never duplicated into this script.
    if command -v tmux >/dev/null 2>&1 && tmux has-session >/dev/null 2>&1; then
        local want live
        want="$(sed -n "s/^set -g status-style '\(.*\)'$/\1/p" "$HOME/.config/tmux/theme-$mode.conf" 2>/dev/null)"
        live="$(tmux show -gv status-style 2>/dev/null)"
        status_for "$want" "$live"; row tmux "$live" "$STATUS"
    else
        row tmux "no server" "-"
    fi

    local socks=0 nmode="" sock
    for sock in "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"/nvim.*; do
        [ -S "$sock" ] || continue
        socks=$((socks + 1))
        nmode="$(nvim --server "$sock" --remote-expr 'luaeval("vim.o.background")' 2>/dev/null)"
        status_for "$mode" "$nmode"; row nvim "$nmode  ($(basename "$sock"))" "$STATUS"
    done
    [ "$socks" -eq 0 ] && row nvim "not running" "-"

    local esock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/emacs/server"
    if [ -S "$esock" ] && command -v emacsclient >/dev/null 2>&1; then
        local etheme emode
        etheme="$(emacsclient --eval '(format "%s" (car custom-enabled-themes))' 2>/dev/null | tr -d \"\\\"\")"
        case "$etheme" in *operandi*) emode=light ;; *vivendi*) emode=dark ;; *) emode="$etheme" ;; esac
        status_for "$mode" "$emode"; row emacs "$etheme" "$STATUS"
    else
        row emacs "no server" "-"
    fi

    # starship picks its palette from whichever config the shell points at.
    if [ "$mode" = light ]; then
        if [ -r "$STARSHIP_LIGHT" ] && grep -q '^palette = "modus_light"' "$STARSHIP_LIGHT"; then
            row starship "modus_light (generated)" "ok"
        else
            row starship "light config missing" "MISMATCH"; MISMATCH=1
        fi
    else
        if grep -q '^palette = "modus_dark"' "$HOME/.config/starship.toml" 2>/dev/null; then
            row starship "modus_dark" "ok"
        else
            row starship "no modus palette" "MISMATCH"; MISMATCH=1
        fi
    fi

    # btop names its theme in its own config; the theme files themselves are
    # generated, so a missing one is as much a mismatch as a stale name.
    if command -v btop >/dev/null 2>&1; then
        if ! [ -f "$HOME/.config/btop/themes/modus-$mode.theme" ]; then
            row btop "theme not generated" "MISMATCH"; MISMATCH=1
        elif grep -q "^color_theme = \"modus-$mode\"" "$HOME/.config/btop/btop.conf" 2>/dev/null; then
            row btop "modus-$mode" "ok"
        else
            row btop "config points elsewhere" "MISMATCH"; MISMATCH=1
        fi
    fi

    echo
    if [ "$MISMATCH" -eq 0 ]; then
        echo "all surfaces agree"
    else
        echo "some surfaces disagree -- re-run: theme-mode $mode"
    fi
    return "$MISMATCH"
}

apply() {
    local mode="$1"
    mkdir -p "$(dirname "$STATE_FILE")"
    printf '%s\n' "$mode" > "$STATE_FILE"
    regen_starship_light
    regen_btop
    push_desktop "$mode"
    push_btop    "$mode"
    push_fish    "$mode"
    push_tmux
    push_nvim    "$mode"
    push_emacs   "$mode"
    echo "theme-mode: $mode"
}

case "${1-}" in
    "")            current_mode ;;
    light|dark)    apply "$1" ;;
    --check|check) check ;;
    toggle)        if [ "$(current_mode)" = dark ]; then apply light; else apply dark; fi ;;
    -h|--help)     sed -n '3,20p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)             echo "theme-mode: unknown argument: $1" >&2; exit 2 ;;
esac
