#!/usr/bin/env bash
#
# desktop-theme -- apply the macOS-inspired GNOME desktop look.
#
# setup.sh installs the parts (shell extensions, icon and cursor themes);
# this script is the configuration half and is the only thing here that
# writes gsettings.  It is idempotent -- run it after a fresh bootstrap, or
# any time the desktop drifts back towards stock Ubuntu.
#
#   desktop-theme             apply the look
#   desktop-theme --check     report which parts are installed
#   desktop-theme --dry-run   print every setting without writing one
#   desktop-theme --reset     hand every key it manages back to its default
#
# Traffic-light window buttons (close/minimise/maximise on the LEFT, as on
# macOS) are the one change that is muscle memory rather than looks, so it
# has its own switch:  TRAFFIC_LIGHTS=0 desktop-theme  keeps them on the
# right, the Ubuntu way.
#
# Every extension schema is read from the extension's own schemas/ directory,
# so this works before GNOME has ever loaded the extension.

set -u

TRAFFIC_LIGHTS="${TRAFFIC_LIGHTS:-1}"
EXT_DIR="$HOME/.local/share/gnome-shell/extensions"

DRY_RUN=0
RESET=0
CHECK=0
for arg in "$@"; do
    case "$arg" in
        --dry-run) DRY_RUN=1 ;;
        --reset)   RESET=1 ;;
        --check)   CHECK=1 ;;
        -h|--help)
            sed -n '3,22p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *) echo "desktop-theme: unknown argument: $arg" >&2; exit 2 ;;
    esac
done

if ! command -v gsettings > /dev/null 2>&1; then
    echo "desktop-theme: gsettings not found -- this is a GNOME-only script." >&2
    exit 1
fi

# ── Extensions ────────────────────────────────────────────────
#
# Enabled for the look.  Ubuntu ships ubuntu-dock (a Dash to Dock fork on the
# stock dash-to-dock schema), so the dock below needs no extra extension --
# installing real Dash to Dock alongside it only causes two docks to fight.
ENABLE_EXTENSIONS=(
    ubuntu-dock@ubuntu.com
    ubuntu-appindicators@ubuntu.com
    blur-my-shell@aunetx
    just-perfection-desktop@just-perfection
    rounded-window-corners@fxgn
    search-light@icedman.github.com
    tilingshell@ferrarodomenico.com
)

# Ubuntu's own tiler and Tiling Shell both grab the same drag-to-edge gesture
# and fight over it; Tiling Shell is the one being configured here.
DISABLE_EXTENSIONS=(
    tiling-assistant@ubuntu.com
)

# ── Settings ──────────────────────────────────────────────────
#
# One record per line: extension-uuid|schema|key|value
# An empty first field means a system schema (no --schemadir needed).
# --reset walks this same table, so it resets exactly what was set and
# leaves neighbouring keys in those schemas alone.
# Deliberately absent: color-scheme, gtk-theme and icon-theme. Those follow
# the light/dark mode, and theme-mode(1) owns them -- setting them here would
# force the desktop back to dark every time this script ran.
settings() {
    cat <<'EOF'
|org.gnome.desktop.interface|cursor-theme|'Bibata-Modern-Classic'
|org.gnome.desktop.interface|cursor-size|24
|org.gnome.desktop.interface|font-name|'Inter 11'
|org.gnome.desktop.interface|document-font-name|'Inter 11'
|org.gnome.desktop.interface|monospace-font-name|'SauceCodePro Nerd Font 12'
|org.gnome.desktop.interface|font-antialiasing|'rgba'
|org.gnome.desktop.interface|font-hinting|'slight'
|org.gnome.desktop.interface|enable-hot-corners|true
|org.gnome.desktop.interface|enable-animations|true
|org.gnome.desktop.interface|clock-show-weekday|true
|org.gnome.desktop.interface|show-battery-percentage|true
|org.gnome.desktop.wm.preferences|titlebar-font|'Inter 11'
|org.gnome.desktop.wm.preferences|resize-with-right-button|true
|org.gnome.mutter|center-new-windows|true
|org.gnome.mutter|attach-modal-dialogs|true
|org.gnome.mutter|edge-tiling|true
|org.gnome.desktop.peripherals.touchpad|natural-scroll|true
|org.gnome.desktop.peripherals.touchpad|tap-to-click|true
|org.gnome.desktop.peripherals.touchpad|two-finger-scrolling-enabled|true
|org.gnome.desktop.peripherals.touchpad|disable-while-typing|true
|org.gnome.shell.extensions.ding|show-home|false
|org.gnome.shell.extensions.ding|start-corner|'top-right'
|org.gnome.shell.extensions.dash-to-dock|dock-position|'BOTTOM'
|org.gnome.shell.extensions.dash-to-dock|extend-height|false
|org.gnome.shell.extensions.dash-to-dock|dock-fixed|false
