blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|override-background|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|unblur-in-overview|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.overview|blur|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.overview|customize|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.overview|sigma|30
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.overview|brightness|0.6
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.dash-to-dock|blur|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.dash-to-dock|static-blur|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.dash-to-dock|customize|true
