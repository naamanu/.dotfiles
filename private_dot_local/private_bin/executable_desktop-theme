|org.gnome.shell.extensions.dash-to-dock|intellihide|true
|org.gnome.shell.extensions.dash-to-dock|intellihide-mode|'FOCUS_APPLICATION_WINDOWS'
|org.gnome.shell.extensions.dash-to-dock|dash-max-icon-size|44
|org.gnome.shell.extensions.dash-to-dock|show-apps-at-top|false
|org.gnome.shell.extensions.dash-to-dock|show-show-apps-button|true
|org.gnome.shell.extensions.dash-to-dock|show-trash|false
|org.gnome.shell.extensions.dash-to-dock|show-mounts|false
|org.gnome.shell.extensions.dash-to-dock|running-indicator-style|'DOTS'
|org.gnome.shell.extensions.dash-to-dock|click-action|'minimize-or-previews'
|org.gnome.shell.extensions.dash-to-dock|scroll-action|'cycle-windows'
|org.gnome.shell.extensions.dash-to-dock|apply-custom-theme|false
|org.gnome.shell.extensions.dash-to-dock|custom-theme-shrink|true
|org.gnome.shell.extensions.dash-to-dock|transparency-mode|'FIXED'
|org.gnome.shell.extensions.dash-to-dock|background-opacity|0.25
|org.gnome.shell.extensions.dash-to-dock|animation-time|0.15
|org.gnome.shell.extensions.dash-to-dock|hide-delay|0.15
|org.gnome.shell.extensions.dash-to-dock|show-delay|0.1
|org.gnome.shell.extensions.dash-to-dock|isolate-workspaces|false
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell|hacks-level|1
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|blur|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|static-blur|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|customize|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.panel|sigma|24
