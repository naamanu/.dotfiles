blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|whitelist|['com.mitchellh.ghostty']
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|customize|true
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|sigma|30
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|opacity|230
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|corner-radius|12
blur-my-shell@aunetx|org.gnome.shell.extensions.blur-my-shell.applications|dynamic-opacity|false
just-perfection-desktop@just-perfection|org.gnome.shell.extensions.just-perfection|startup-status|0
just-perfection-desktop@just-perfection|org.gnome.shell.extensions.just-perfection|clock-menu-position|1
