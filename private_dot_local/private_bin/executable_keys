#!/usr/bin/env bash
#
# keys -- searchable keybinding cheatsheet.
#
# Reads the Keybindings section of the dotfiles README rather than keeping a
# second copy: a cheatsheet that can disagree with the documentation is worse
# than no cheatsheet. Add a binding to the README table and it shows up here.
#
#   keys            browse everything, fuzzy-filtered
#   keys emacs      open pre-filtered to a tool or section
#   keys --list     plain output, no fzf (for piping)

set -u

QUERY=""
PLAIN=0
for arg in "$@"; do
    case "$arg" in
        --list)    PLAIN=1 ;;
        -h|--help) sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -*)        echo "keys: unknown option: $arg" >&2; exit 2 ;;
        *)         QUERY="$arg" ;;
    esac
done

# README is not deployed to $HOME -- it is documentation, so chezmoi ignores
# it. The source tree is the only copy, and chezmoi knows where that is.
readme=""
for candidate in \
    "$(chezmoi source-path 2>/dev/null)/README.md" \
    "$HOME/.local/share/chezmoi/README.md"; do
    [ -r "$candidate" ] && { readme="$candidate"; break; }
done
if [ -z "$readme" ]; then
    echo "keys: cannot find the dotfiles README (is chezmoi installed?)" >&2
    exit 1
fi

# Rows look like:  | `C-c e h` | Emacs health check |
# Section headings (## ...) become the first column, so a search for "tmux"
# finds every tmux binding even when the row itself never says "tmux".
extract() {
    awk -F'|' '
        # Everything before the Keybindings heading is prose and command
        # tables (chezmoi usage, and so on) -- not bindings.
        /^# Keybindings/ { inkeys = 1; next }
        !inkeys { next }
        # Both heading levels are kept: the ## names the tool, the ###
        # names the area. Either alone loses something -- "Emacs" for 70 rows
        # is too coarse to filter, and "Git" alone does not say whose.
        /^## / {
            tool = $0
            sub(/^## /, "", tool)
            sub(/ Keybindings.*$/, "", tool)
            sub(/ \(.*$/, "", tool)
            area = ""
            next
        }
        /^### / {
            area = $0
            sub(/^### /, "", area)
            sub(/ \(.*$/, "", area)
            sub(/ [-\xe2\x80\x94].*$/, "", area)
            next
        }
        # Two table shapes exist in the README: two-column (key | description)
        # and Neovim'"'"'s three-column (mode | key | description). Rather than
        # encode both, find the first cell holding a backtick -- that is the
        # key, whatever column it landed in.
        /^\|/ {
            ki = 0
            for (i = 2; i <= NF; i++) if ($i ~ /`/) { ki = i; break }
            if (!ki) next
            key = $ki; desc = $(ki + 1); mode = (ki > 2) ? $2 : ""
            gsub(/^ +| +$/, "", key);  gsub(/`/, "", key)
            gsub(/^ +| +$/, "", desc)
            gsub(/^ +| +$/, "", mode)
            if (key == "" || desc == "") next
            if (mode != "") key = mode " " key
            label = (area == "") ? tool : tool "/" area
            printf "%-22.22s %-24s %s\n", label, key, desc
        }
    ' "$readme"
}

if [ "$PLAIN" -eq 1 ] || ! command -v fzf > /dev/null 2>&1; then
    if [ -n "$QUERY" ]; then extract | grep -i -- "$QUERY"; else extract; fi
    exit 0
fi

extract | fzf \
    --query "$QUERY" \
    --prompt 'keys> ' \
    --header 'Keybindings from the dotfiles README -- Enter copies, Esc quits' \
    --height 100% \
    --layout reverse \
    --info inline \
    --bind 'enter:execute-silent(printf "%s" {2} | (pbcopy 2>/dev/null || wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -ib 2>/dev/null))+abort'
