#!/usr/bin/env bash
set -u
# Deliberately no PATH edits here: the report must reflect what a shell
# actually sees, or the PATH-ordering faults it exists to catch stay hidden.
JSON=0
SHOW_ALL=0
for arg in "$@"; do
    case "$arg" in
        --json) JSON=1 ;;
        --all) SHOW_ALL=1 ;;
        -h|--help) echo "usage: dev-doctor [--json] [--all]"; exit 0 ;;
        *) echo "dev-doctor: unknown argument: $arg" >&2; exit 2 ;;
    esac
done
TOOLS=$(cat <<'EOF'
required|git|version control
required|rg|project search
required|fd|file search
required|fzf|interactive selection
required|direnv|project environments
required|node|TypeScript and JavaScript runtime
required|uv|Python projects and tools
optional|vtsls|TypeScript and JavaScript LSP
optional|vscode-eslint-language-server|ESLint LSP
optional|prettier|web and document formatter
optional|basedpyright-langserver|Python LSP
optional|ruff|Python lint and format
optional|rust-analyzer|Rust LSP
optional|gopls|Go LSP
optional|dlv|Go debugger
optional|clangd|C and C++ LSP
optional|lldb-dap|native debugger adapter
optional|ocamllsp|OCaml LSP
optional|ocamlformat|OCaml formatter
optional|haskell-language-server-wrapper|Haskell LSP
optional|ormolu|Haskell formatter
optional|lua-language-server|Lua LSP
optional|stylua|Lua formatter
optional|bash-language-server|shell LSP
optional|shellcheck|shell lint
optional|shfmt|shell formatter
optional|yaml-language-server|YAML LSP
optional|docker-langserver|Dockerfile LSP
optional|sql-formatter|SQL formatter
optional|tree-sitter|parser compiler
optional|pandoc|research document conversion
optional|gh|GitHub workflows
optional|lazygit|terminal Git UI
optional|yazi|terminal file manager
optional|fastfetch|system summary
optional|flameshot|screenshot and annotation
optional|codex|terminal coding agent
optional|claude|terminal coding agent
EOF
)

# Version floors the editor configs depend on: tool|minimum|how to read the version.
FLOORS=$(cat <<'EOF'
nvim|0.10.0|nvim --version | sed -n '1s/^NVIM v//p'
tree-sitter|0.22.0|tree-sitter --version | awk '{print $2}'
fish|4.0.0|fish --version | awk '{print $3}'
tmux|3.3|tmux -V | awk '{print $2}' | tr -d a-z
git|2.38.0|git --version | awk '{print $3}'
emacs|30.1|emacs --version | sed -n '1s/^GNU Emacs //p'
EOF
)
version_ge() { [ "$(printf '%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]; }
[ "$JSON" -eq 0 ] || printf '['
first=1
missing_required=0
while IFS='|' read -r kind command description; do
    [ -n "$command" ] || continue
    path=$(command -v "$command" 2>/dev/null || true)
    if [ -z "$path" ] && [ "$kind" = required ]; then missing_required=$((missing_required + 1)); fi
    if [ "$JSON" -eq 1 ]; then
        [ "$first" -eq 1 ] || printf ','
        first=0
        if [ -n "$path" ]; then
            printf '\n  {"kind":"%s","command":"%s","status":"ok","path":"%s","description":"%s"}' "$kind" "$command" "$path" "$description"
        else
            printf '\n  {"kind":"%s","command":"%s","status":"missing","path":null,"description":"%s"}' "$kind" "$command" "$description"
        fi
    elif [ -n "$path" ] || [ "$SHOW_ALL" -eq 1 ] || [ "$kind" = required ]; then
        if [ -n "$path" ]; then status=ok; else status=MISSING; fi
        printf '[%-7s] %-36s %-8s %s\n' "$status" "$command" "$kind" "$description"
        [ -z "$path" ] || printf '          %s\n' "$path"
    fi
done <<EOF
$TOOLS
EOF
too_old=0
if [ "$JSON" -eq 1 ]; then printf '\n]\n'; else
    printf '\nVersion floors:\n'
    while IFS='|' read -r command minimum probe; do
        [ -n "$command" ] || continue
        if ! command -v "$command" >/dev/null 2>&1; then
            printf '[%-7s] %-14s >= %-8s not installed\n' MISSING "$command" "$minimum"
            continue
        fi
        have=$(eval "$probe" 2>/dev/null | head -1)
        if [ -n "$have" ] && version_ge "$have" "$minimum"; then
            printf '[%-7s] %-14s >= %-8s %s\n' ok "$command" "$minimum" "$have"
        else
            printf '[%-7s] %-14s >= %-8s %s\n' OLD "$command" "$minimum" "${have:-unknown}"
            too_old=$((too_old + 1))
        fi
    done <<EOF
$FLOORS
EOF
fi
[ "$missing_required" -eq 0 ] && [ "$too_old" -eq 0 ]
