[user]
	name = Nana Adjei Manu
	email = n.k.a.manu06@gmail.com
# Work checkouts get their own identity from an unmanaged ~/.gitconfig-work.
[includeIf "gitdir:~/workspace/work/"]
	path = ~/.gitconfig-work
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	# pull --rebase with a dirty tree stashes and restores automatically.
	autostash = true
	# Rebasing a stack moves the branches that point into it too.
	updateRefs = true
[core]
	editor = nvim
	# Exclude machine-specific configs from global .gitconfig
	excludesfile = ~/.gitignore_global
	pager = delta
{{- if eq .chezmoi.os "darwin" }}
	# Built-in file watcher (macOS build ships it): status on large trees
	# stops walking the disk.
	fsmonitor = true
	untrackedCache = true
{{- end }}
[commit]
	# Show the full diff in the commit message buffer.
	verbose = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[help]
	# Offer the correction instead of running it after a delay.
	autocorrect = prompt
[alias]
	a = add
	ap = add -p
	aa = add -A
	b = branch
	bd = branch -D
	ca = commit --amend
	cm = commit -m
	co = checkout
	cp = cherry-pick
	d = diff
	dc = diff --cached
	f = fetch
	l = log --oneline --graph --decorate
	p = push
	pf = push --force-with-lease
	pr = pull --rebase
	rh = reset --hard
	s = status -s
	sh = show
	st = stash
	sta = stash apply
	std = stash drop
	stl = stash list
	stp = stash pop
	unstage = reset HEAD --
[color]
	ui = auto
[push]
	# Push to the same branch you are on
	default = current
	autoSetupRemote = true
	followTags = true
[fetch]
	# Prune remote branches and tags that no longer exist
	prune = true
	prunetags = true
	fsckobjects = true
[transfer]
	fsckobjects = true
[receive]
	fsckObjects = true
[submodule]
	recurse = true
[rerere]
	enabled = true
	# Re-stage the recorded resolution, not just replay it into the tree.
	autoupdate = true
[diff]
	algorithm = histogram
	colorMoved = default
	# i/ w/ c/ prefixes say which side is index, worktree, commit.
	mnemonicPrefix = true
	renames = copies
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
[merge]
	# zdiff3 shows the common ancestor in conflicts, which makes
	# three-way merges far easier to reason about than the default.
	conflictStyle = zdiff3
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
