# Ghostty Terminal Configuration

# Font configuration
# Same faces as Emacs: Iosevka Comfy for text, Symbols Nerd Font for icons.
font-family = "Iosevka Comfy"
font-family = "Symbols Nerd Font Mono"
font-size = 17
font-thicken = true

# Window configuration
# Roomier padding than the default: the desktop runs rounded window corners,
# and tight padding puts the first column right up against the curve.
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = true
window-theme = auto
# Option is Meta. Without this, Option+h types a composed character, so tmux's
# M-hjkl resize and every Emacs M- binding are unreachable on macOS.
macos-option-as-alt = true
window-save-state = always

# Theme and colors
# Both halves at once: Ghostty follows the desktop colour-scheme, which
# theme-mode(1) sets, so the terminal turns over with everything else and needs
# no push of its own.
theme = light:Modus Operandi,dark:Modus Vivendi Tinted
# Translucent so the desktop blur reads through the terminal. `background-blur`
# is honoured on macOS and KDE/Wayland; on GNOME/X11 it is a no-op and Blur My
# Shell provides the blur instead, whitelisted to com.mitchellh.ghostty by
# `desktop-theme`.
background-opacity = 0.92
background-blur = true
unfocused-split-opacity = 0.95

# Shell
shell-integration = fish
shell-integration-features = cursor,sudo,title

# Keybindings: the defaults already cover copy/paste/tabs on both platforms
# (ctrl+shift on Linux, cmd on macOS). Only non-default bindings go here.
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

# Selection
copy-on-select = true

# Cursor
cursor-style = block
cursor-style-blink = true
