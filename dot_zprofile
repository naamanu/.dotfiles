eval "$(/opt/homebrew/bin/brew shellenv zsh)"

# User-local binaries (uv tools, standalone installers)
export PATH="$HOME/.local/bin:$PATH"

# Default JDK; preserve a project-selected JAVA_HOME.
if [ -z "${JAVA_HOME:-}" ]; then
    for jdk in /opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home /usr/local/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home; do
        if [ -d "$jdk" ]; then
            export JAVA_HOME="$jdk"
            break
        fi
    done
    unset jdk
fi
if [ -n "${JAVA_HOME:-}" ]; then
    export PATH="$JAVA_HOME/bin:$PATH"
fi
